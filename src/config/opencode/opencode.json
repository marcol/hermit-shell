{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "google": {
      "options": {
        "thinking": "low"
      }
    },
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "qwen3-coder": {
          "id": "qwen3-coder-next:cloud"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "google/gemini-flash-latest"
    },
    "build": {
      "model": "ollama/qwen3-coder"
    }
  },
  "default_agent": "plan"
}
