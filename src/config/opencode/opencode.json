{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "provider": {
        "google": {
            "name": "by Google",
            "options": {
                "apiKey": "{env:GEMINI_API_KEY}",
                "thinkingConfig": {
                    "thinkingLevel": "high",
                    "includeThoughts": true
                }
            },
            "models": {
                "gemma": {
                    "id": "gemma-4-31b-it",
                    "name": "Gemma 4 31b"
                },
                "flash": {
                    "id": "gemini-3.8-flash",
                    "name": "Gemini Flash"
                },
                "gemini": {
                    "id": "gemini-3.8-live-extended-thinking",
                    "name": "Gemini Thinking"
                },
                "nano": {
                    "id": "gemini-nano-banana-2.1",
                    "name": "Nano Banana"
                }
            }
        },
        "deepseek": {
            "models": {
                "settings": {
                    "baseURL": "https://api.deepseek.com/v1",
                    "apiKey": "sk-acd6f1ffb6e7469ab4ebc3790dcea446"
                },
                "deepseek-r1": {
                    "name": "DeepSeek R1",
                    "modelID": "deepseek-reasoner"
                },
                "deepseek-v4.1-flash": {
                    "name": "DeepSeek V4.1 Flash",
                    "modelID": "deepseek-v4.1-flash"
                }
            }
        },
        "ollama": {
            "name": "by Ollama",
            "options": {
                "baseURL": "http://localhost:11434/v1",
                "apiKey": "{env:OLLAMA_API_KEY}"
            },
            "models": {
                "qwen:local": {
                    "id": "qwen3.8:latest",
                    "name": "Qwen"
                },
                "qwen-code:local": {
                    "id": "qwen3-coder:latest",
                    "name": "Qwen-code"
                },
                "glm-ocr:local": {
                    "id": "glm-ocr:latest",
                    "name": "GLM"
                }
            }
        }
    },
    "default_agent": "plan"
}
