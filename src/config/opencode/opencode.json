{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "google": {
      "options": {
        "thinking": "medium"
      }
    },
    "ollama": {
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3": {
          "id": "qwen3-coder:latest"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "model": "google/gemini-3.1-flash-preview"
    },
    "build": {
      "model": "ollama/qwen3"
    }
  },
  "default_agent": "plan"
}
